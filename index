<!DOCTYPE html>
<html lang="zh-TW">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>JTMolly — Founder, Acheloy Biomedicine</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400;1,600&family=DM+Mono:wght@300;400&family=Noto+Serif+TC:wght@300;400&display=swap');

  :root {
    --rose: #C8927A;
    --rose-light: #E8C4B4;
    --rose-pale: #F5EBE6;
    --ink: #1C1612;
    --ink-mid: #4A3F38;
    --ink-soft: #8C7B72;
    --gold: #B8965A;
    --cream: #FAF6F2;
    --white: #FFFFFF;
    --border: rgba(200, 146, 122, 0.2);
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  html { scroll-behavior: smooth; }

  body {
    font-family: 'Noto Serif TC', serif;
    background: var(--ink);
    color: var(--cream);
    min-height: 100vh;
    overflow-x: hidden;
  }

  /* ── NOISE OVERLAY ── */
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.03'/%3E%3C/svg%3E");
    pointer-events: none;
    z-index: 0;
    opacity: 0.4;
  }

  /* ── AMBIENT GLOW ── */
  .glow-1 {
    position: fixed;
    top: -30vh; right: -20vw;
    width: 70vw; height: 70vw;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(200,146,122,0.08) 0%, transparent 65%);
    pointer-events: none;
    z-index: 0;
  }

  .glow-2 {
    position: fixed;
    bottom: -20vh; left: -15vw;
    width: 50vw; height: 50vw;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(184,150,90,0.06) 0%, transparent 65%);
    pointer-events: none;
    z-index: 0;
  }

  /* ── LAYOUT ── */
  .page {
    position: relative;
    z-index: 1;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 80px 24px;
  }

  /* ── HEADER ── */
  .header {
    text-align: center;
    margin-bottom: 72px;
    animation: fadeUp 1s ease both;
  }

  .eyebrow {
    font-family: 'DM Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.35em;
    color: var(--rose);
    text-transform: uppercase;
    margin-bottom: 24px;
    display: block;
  }

  .name {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(52px, 10vw, 100px);
    font-weight: 300;
    font-style: italic;
    color: var(--cream);
    line-height: 0.95;
    letter-spacing: -0.02em;
    margin-bottom: 20px;
  }

  .name span {
    color: var(--rose);
  }

  .divider {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    margin: 20px auto 24px;
  }

  .divider-line {
    width: 40px;
    height: 1px;
    background: var(--rose);
    opacity: 0.5;
  }

  .divider-dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--rose);
    opacity: 0.7;
  }

  .tagline {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(14px, 2vw, 18px);
    font-weight: 300;
    color: var(--ink-soft);
    letter-spacing: 0.08em;
    line-height: 1.8;
  }

  .tagline-zh {
    font-family: 'Noto Serif TC', serif;
    font-size: 13px;
    color: var(--ink-soft);
    letter-spacing: 0.15em;
    margin-top: 6px;
    display: block;
  }

  /* ── BIO ── */
  .bio {
    max-width: 480px;
    text-align: center;
    margin-bottom: 64px;
    animation: fadeUp 1s 0.15s ease both;
  }

  .bio p {
    font-family: 'Cormorant Garamond', serif;
    font-size: 17px;
    font-weight: 300;
    color: var(--ink-soft);
    line-height: 1.9;
    font-style: italic;
  }

  .bio p + p {
    margin-top: 12px;
    font-family: 'Noto Serif TC', serif;
    font-size: 13px;
    font-style: normal;
    letter-spacing: 0.05em;
    color: #6B5E57;
  }

  /* ── CARDS ── */
  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    width: 100%;
    max-width: 780px;
    animation: fadeUp 1s 0.3s ease both;
  }

  .card {
    position: relative;
    background: rgba(255,255,255,0.02);
    border: 1px solid var(--border);
    padding: 32px 28px;
    border-radius: 2px;
    text-decoration: none;
    color: inherit;
    transition: background 0.3s ease, border-color 0.3s ease, transform 0.3s ease;
    overflow: hidden;
    cursor: pointer;
    display: block;
  }

  .card::before {
    content: '';
    position: absolute;
    bottom: 0; left: 0;
    width: 100%; height: 2px;
    background: linear-gradient(to right, transparent, var(--rose), transparent);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .card:hover {
    background: rgba(200,146,122,0.05);
    border-color: rgba(200,146,122,0.4);
    transform: translateY(-3px);
  }

  .card:hover::before {
    opacity: 1;
  }

  .card-icon {
    font-family: 'DM Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.3em;
    color: var(--rose);
    text-transform: uppercase;
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .card-icon::before {
    content: '';
    display: inline-block;
    width: 16px;
    height: 1px;
    background: var(--rose);
    flex-shrink: 0;
  }

  .card-title-zh {
    font-family: 'Noto Serif TC', serif;
    font-size: 18px;
    font-weight: 400;
    color: var(--cream);
    letter-spacing: 0.1em;
    margin-bottom: 8px;
    line-height: 1.4;
  }

  .card-title-en {
    font-family: 'Cormorant Garamond', serif;
    font-size: 13px;
    font-style: italic;
    color: var(--ink-soft);
    letter-spacing: 0.05em;
    margin-bottom: 20px;
  }

  .card-desc {
    font-size: 12px;
    color: var(--ink-soft);
    line-height: 1.85;
    letter-spacing: 0.03em;
  }

  .card-arrow {
    position: absolute;
    bottom: 24px; right: 24px;
    font-family: 'Cormorant Garamond', serif;
    font-size: 20px;
    color: var(--rose);
    opacity: 0;
    transition: opacity 0.3s ease, transform 0.3s ease;
    transform: translateX(-4px);
  }

  .card:hover .card-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  /* ── SOCIAL ── */
  .social {
    display: flex;
    gap: 20px;
    margin-top: 48px;
    animation: fadeUp 1s 0.45s ease both;
  }

  .social a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--border);
    border-radius: 50%;
    color: var(--ink-soft);
    text-decoration: none;
    transition: border-color 0.3s ease, color 0.3s ease, background 0.3s ease, transform 0.3s ease;
  }

  .social a:hover {
    border-color: var(--rose);
    color: var(--rose);
    background: rgba(200,146,122,0.08);
    transform: translateY(-2px);
  }

  .social a svg {
    width: 18px;
    height: 18px;
    fill: currentColor;
  }

  /* ── FOOTER ── */
  .footer {
    position: fixed;
    bottom: 28px;
    left: 50%;
    transform: translateX(-50%);
    font-family: 'DM Mono', monospace;
    font-size: 9px;
    letter-spacing: 0.25em;
    color: #3A2E28;
    text-transform: uppercase;
    white-space: nowrap;
    z-index: 1;
  }

  /* ── MODAL ── */
  .modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(28,22,18,0.92);
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
    backdrop-filter: blur(8px);
  }

  .modal-overlay.active {
    opacity: 1;
    pointer-events: all;
  }

  .modal {
    background: var(--cream);
    max-width: 640px;
    width: 100%;
    max-height: 80vh;
    overflow-y: auto;
    border-radius: 2px;
    padding: 48px 40px;
    transform: translateY(16px);
    transition: transform 0.3s ease;
    position: relative;
  }

  .modal-overlay.active .modal {
    transform: translateY(0);
  }

  .modal-close {
    position: absolute;
    top: 20px; right: 24px;
    font-family: 'DM Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.2em;
    color: var(--ink-soft);
    cursor: pointer;
    text-transform: uppercase;
    background: none;
    border: none;
    transition: color 0.2s;
  }

  .modal-close:hover { color: var(--rose); }

  .modal-label {
    font-family: 'DM Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.3em;
    color: var(--rose);
    text-transform: uppercase;
    margin-bottom: 16px;
  }

  .modal-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 32px;
    font-weight: 300;
    font-style: italic;
    color: var(--ink);
    margin-bottom: 24px;
    line-height: 1.2;
  }

  .modal-body {
    font-size: 14px;
    color: var(--ink-mid);
    line-height: 1.9;
  }

  .modal-body p { margin-bottom: 12px; }
  .modal-body p:last-child { margin-bottom: 0; }

  .modal-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 28px;
    font-family: 'DM Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.2em;
    color: var(--rose);
    text-decoration: none;
    text-transform: uppercase;
    border-bottom: 1px solid rgba(200,146,122,0.3);
    padding-bottom: 4px;
    transition: border-color 0.2s;
  }

  .modal-link:hover { border-color: var(--rose); }

  /* ── ANIMATIONS ── */
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 680px) {
    .cards { grid-template-columns: 1fr; max-width: 400px; }
    .page { padding: 60px 20px 80px; }
    .modal { padding: 36px 24px; }
  }

  @media (max-width: 400px) {
    .social { flex-wrap: wrap; justify-content: center; gap: 20px; }
  }
</style>
</head>
